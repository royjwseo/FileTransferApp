#include <windows.h>
#include "../include/AppVersion.h"
1 VERSIONINFO
 FILEVERSION FTA_VERSION_MAJOR,FTA_VERSION_MINOR,FTA_VERSION_PATCH,0
 PRODUCTVERSION FTA_VERSION_MAJOR,FTA_VERSION_MINOR,FTA_VERSION_PATCH,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "royjwseo"
   VALUE "FileDescription", "FileTransferApp"
   VALUE "FileVersion", FTA_VERSION_STRING
   VALUE "ProductName", "FileTransferApp"
   VALUE "ProductVersion", FTA_VERSION_STRING
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
